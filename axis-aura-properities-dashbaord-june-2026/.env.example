# Copy to .env and fill in real values. Never commit .env.

# Public API base URL (exposed to the browser).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Server-side only — must match the API's JWT_SECRET.
# Middleware uses it to verify the session cookie's signature and expiry.
# If unset, the dashboard falls back to a cookie-presence check only.
JWT_SECRET=
