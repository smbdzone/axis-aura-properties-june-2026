# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# --- Server ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# Required in production — there is no permissive default.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# How long (ms) the middleware caches a user's role/status/permissions before
# re-reading the database. API-driven changes invalidate immediately; this only
# bounds out-of-band DB edits. Default 30000. Set 0 to disable the cache.
AUTH_CACHE_TTL_MS=30000

# --- Email (Gmail app password, not the account password) ---
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# --- Google Analytics (optional; endpoint returns 503 when unset) ---
# Numeric GA4 property id, e.g. 495390133
GA4_PROPERTY_ID=
# Either paste the service-account JSON here...
GOOGLE_ANALYTICS_CREDENTIALS=
# ...or point at a file on disk. Keep that file out of git.
GOOGLE_ANALYTICS_CREDENTIALS_PATH=

# --- Media storage ---
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
